# Ortam değişkenleri — gerçek değerler asla depoya girmez
.env
.env.local
.env.production

# Prisma tarafından üretilen client
/src/generated/

# Yerel dosya depolama (VPS'te kalıcı bir dizine/S3'e taşınacak)
/depolama/

# Tema karşılaştırması için alınan ekran görüntüleri
/ekran-goruntuleri/

# Yerel çalışma dosyaları: geçici script'ler, araçlara verilen istem metinleri,
# inceleme çıktıları. Kalıcı belge değiller; depoya girerlerse bir sonraki
# incelemede yeniden "bu ne, güncel mi?" sorusunu doğururlar.
/scripts/_*.ts
/belge-promptu.md
/PROJE-INCELEME-RAPORU.md
/.claude/settings.local.json
# Kök dizindeki geçici betikler ve çıktı klasörleri (yukarıdaki gerekçenin
# aynısı; desen eksikti, dosyalar birikmişti).
/.tmp-*

# BAŞKA BİR EKİBİN PANELİNDEN ALINMIŞ EKRAN GÖRÜNTÜLERİ.
#
# Depo GitHub'da HERKESE AÇIK. `manisa/` altındaki görüntülerde gerçek
# öğrencilerin ad-soyadı ve e-posta adresleri, ekli tabloda ise öğretmen
# adları görünüyor. Karşılaştırma için alınmış çalışma malzemesi; incelemesi
# `manisa-farklari-plani.md` içinde yazılı ve o belge kişisel veri taşımıyor.
#
# Görüntüler paylaşılacaksa bu ayrı bir karardır ve KVKK tarafı önce
# değerlendirilmelidir — herkese açık bir depoya girdikten sonra geçmişten
# silmek de ayrı bir iştir.
/manisa/

# GÖREV KARTLARININ TASLAK GÖRSELLERİ (WhatsApp'tan gelen ekran görüntüleri).
#
# `manisa/` ile aynı gerekçe: depo GitHub'da HERKESE AÇIK ve bunlar tasarımın
# konuşulduğu çalışma malzemesi, ürünün parçası değil. İstenen düzen zaten
# koda ve karar yorumlarına geçti; görüntülerin depoda durmasının bir karşılığı
# yok.
/gorevlerim/

*.log
